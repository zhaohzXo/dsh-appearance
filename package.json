{
  "name": "@workfile/dsh-appearance",
  "version": "0.4.0",
  "description": "Wallpaper, built-in wallpapers and boot intro for the DeepSeek Harness Web UI",
  "type": "module",
  "license": "MIT",
  "author": "zhaohz",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "wallpaper",
    "theme",
    "boot-intro"
  ],
  "homepage": "https://github.com/2BingLing/dsh-appearance#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/2BingLing/dsh-appearance.git"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./icon": "./icon.svg",
    "./locale/*": "./locale/*"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings-general",
        "@deepseek-ai/dsh-client-ui-theme"
      ]
    }
  }
}
