{
  "name": "@workfile/dsh-appearance",
  "version": "0.4.0",
  "private": true,
  "description": "Wallpaper and boot-intro appearance page for the DeepSeek Harness Web UI",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./icon": "./icon.svg",
    "./locale/*": "./locale/*"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings-general",
        "@deepseek-ai/dsh-client-ui-theme"
      ]
    }
  }
}
